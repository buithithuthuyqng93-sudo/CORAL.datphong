# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ==============================================================================
# HOMESTAY & CAFE SEAGULL LÝ SƠN - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. SUPABASE DATABASE (PostgreSQL)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. SEPAY VIETQR AUTOMATIC WEBHOOK INTEGRATION
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret-key

# 3. GMAIL API CONFIRMATION EMAIL INTEGRATION
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token
GMAIL_SENDER_EMAIL=seagull.lyson@gmail.com

# 4. GOOGLE SHEETS OPERATIONAL BACKUP SYNC
GOOGLE_SHEET_ID=your-google-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# 5. BUSINESS RULES & SYSTEM SECURITY
BOOKING_HOLD_MINUTES=15
CRON_SECRET=your-random-cron-secret-key
TIMEZONE=Asia/Ho_Chi_Minh
