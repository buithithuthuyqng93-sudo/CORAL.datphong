{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 20 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/bookings/lookup", "destination": "/api/bookings" },
    { "source": "/api/sepay/webhook", "destination": "/api/sepay" },
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/media/:path*", "destination": "/api/media" },
    { "source": "/api/cms/:path*", "destination": "/api/cms" },
    { "source": "/api/cron/expire-holds", "destination": "/api/cron" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
